# Path to the SQLite database. The directory must exist and be writable.
DATABASE_PATH=./data/shrtl.db

# Absolute base URL used when displaying a short link. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000

# Bind address. 0.0.0.0 listens on every interface; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Set to 1 only when the app is behind a reverse proxy you control: it makes the
# client IP come from X-Forwarded-For. Without it the socket address is used, so a
# direct caller cannot spoof an IP and walk past the rate limiter.
TRUST_PROXY=

# Sliding session lifetime, in hours.
SESSION_TTL_HOURS=720

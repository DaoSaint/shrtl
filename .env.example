# Path to the SQLite database. Its directory is created when missing.
DATABASE_PATH=./data/shrtl.db

PORT=3000

# Bind address. 0.0.0.0 listens on every interface; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Set to 1 only behind a reverse proxy you control: the client IP is then read
# from X-Forwarded-For. Left unset, the socket address is used, so a direct
# caller cannot spoof an address and walk past the login rate limiter.
TRUST_PROXY=

{
    "name": "shrtl",
    "version": "0.0.0",
    "description": "A small self-hosted URL shortener: public links and session-protected ones.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "bun": ">=1.4"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "docker:test": "sh scripts/test-docker.sh",
        "docker:smoke": "sh scripts/smoke-docker.sh",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun src/db/migrate.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@node-rs/argon2": "^2.2.2",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.13",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.3.6",
        "drizzle-kit": "^0.31.11",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    },
    "packageManager": "bun@1.4.3"
}
